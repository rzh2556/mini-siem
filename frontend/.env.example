# ============================================================
# Mini SIEM 前端环境变量（复制为 .env 后按需修改）
# ============================================================

# API 基础前缀，默认 /api/v1（开发时由 vite proxy 转发到 http://localhost:8000）
VITE_API_BASE=/api/v1

# 默认访问令牌，对应后端 API_TOKEN；留空表示后端未开启鉴权
# 运行期可在页面右上角覆盖，覆盖值保存在 localStorage 的 siem_token 中
VITE_API_TOKEN=
