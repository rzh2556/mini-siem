[Unit]
Description=Mini SIEM 后端服务（SQLite 单进程，低负载）
Documentation=https://gitee.com/qwe002/mini-siem
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minisiem
Group=minisiem
WorkingDirectory=/opt/mini-siem/backend
EnvironmentFile=/opt/mini-siem/.env
# 单进程即可支撑小规模日志；workers 越多越吃内存
ExecStart=/opt/mini-siem/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

# ---- 资源限制：避免异常时拖垮 1~2G 小内存机器 ----
MemoryMax=512M
MemoryHigh=384M

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mini-siem/data

[Install]
WantedBy=multi-user.target
