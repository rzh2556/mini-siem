# ============================================================
# Mini SIEM 环境变量配置（复制为 .env 后按需修改）
# ============================================================

# ---------- 存储后端 ----------
# sqlite：零依赖、低负载，适合 1~2G 内存的小服务器（默认）
# elasticsearch：功能全但至少占 1.5G 内存，需要额外部署 ES
STORAGE_BACKEND=sqlite
# SQLite 数据库文件路径（STORAGE_BACKEND=sqlite 时生效）
SQLITE_PATH=data/siem.db

# ---------- 前端静态资源 ----------
# 非空且目录存在时，由后端直接托管前端构建产物，可省掉 nginx
# 例如裸机部署填 /opt/mini-siem/frontend/dist
FRONTEND_DIST=

# ---------- Elasticsearch（STORAGE_BACKEND=elasticsearch 时生效） ----------
ES_URL=http://elasticsearch:9200
ES_INDEX_PREFIX=siem
# 索引保留天数，超过自动删除（SQLite 后端同样用该值清理过期日志）
ES_RETENTION_DAYS=30

# ---------- 服务端口 ----------
BACKEND_PORT=8000
FRONTEND_PORT=80

# ---------- 采集鉴权 ----------
# Agent 上报日志时必须携带的令牌（X-Agent-Token），务必修改
AGENT_TOKEN=change-me-agent-token
# 第三方 API 静态令牌（可选）：设置后可用该 Bearer 令牌调用数据查询接口；
# 注意：浏览器端始终需要用管理员账号登录，与本令牌无关
API_TOKEN=

# ---------- 管理后台登录 ----------
# 管理员账号（首次启动时自动创建）
ADMIN_USERNAME=admin
# 管理员初始密码：留空时默认 admin123，首次登录会被强制要求修改；
# 也可在此指定自己的初始密码（登录后可随时修改，修改后以系统库中的密码为准）
ADMIN_PASSWORD=
# JWT 签名密钥：留空则首次启动随机生成并持久化到系统库；多实例共享会话时可显式指定
JWT_SECRET=
# 登录令牌有效期（小时）
TOKEN_EXPIRE_HOURS=12
# 账号、密码等系统数据使用的独立 SQLite 库（与日志存储后端无关）
SYSTEM_DB_PATH=data/system.db

# ---------- GeoIP ----------
# MaxMind GeoLite2-City.mmdb 文件路径（容器内路径），留空则跳过
GEOIP_DB_PATH=
# 无 mmdb 时是否使用在线免费接口(ip-api.com)解析，需服务器可访问外网
GEOIP_ONLINE_FALLBACK=true

# ---------- 规则 ----------
RULES_DIR=/app/rules
# 规则热加载间隔（秒）
RULES_RELOAD_INTERVAL=60

# ---------- 告警降噪 ----------
# 全局告警合并窗口（秒），同规则同分组在该窗口内合并为一条告警
ALERT_COOLDOWN=300
# 低于该等级的告警直接丢弃(low/medium/high/critical)
MIN_ALERT_SEVERITY=low
# 全局 IP 白名单，逗号分隔，命中则不计入告警
IP_WHITELIST=127.0.0.1,::1
# 是否跳过内网源 IP 的告警
IGNORE_INTERNAL_SRC=false

# ---------- 启动参数 ----------
LOG_LEVEL=INFO
CORS_ORIGINS=*
